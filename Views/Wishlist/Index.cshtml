@model TimeVerse.ViewModels.Wishlist.WishlistViewModel
@{
    ViewData["Title"] = "My Wishlist — TimeVerse";
}

<div class="luxury-container py-5" style="max-width: 1200px; margin: 0 auto; padding-left: 1rem; padding-right: 1rem;">
    <!-- Breadcrumb & Header -->
    <nav class="breadcrumb-nav mb-4" aria-label="breadcrumb">
        <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">Home</a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-dark fw-semibold">My Wishlist</span>
    </nav>

    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <span class="tv-section-tag mb-1" style="color: var(--tv-accent);">Saved Timepieces</span>
            <h1 class="display-6 fw-bold mb-0" style="font-family: var(--tv-font-heading); color: var(--tv-primary);">MY WISHLIST</h1>
        </div>
        <span class="text-muted">@Model.TotalCount @(Model.TotalCount == 1 ? "watch" : "watches") saved</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius: 8px;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: 8px;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="card text-center py-5 my-4" style="background: var(--tv-white); border: 1px solid var(--tv-border); border-radius: 12px; box-shadow: var(--tv-shadow-subtle);">
            <div class="card-body py-4">
                <div class="display-1 text-muted mb-3"><i class="bi bi-heart"></i></div>
                <h3 class="fw-bold mb-2" style="font-family: var(--tv-font-heading); color: var(--tv-primary);">Your Wishlist is Empty</h3>
                <p class="text-muted max-w-md mx-auto mb-4" style="max-width: 480px; margin: 0 auto 1.5rem;">
                    Save watches you love to your personal wishlist to keep track of availability, price updates, or move directly into your cart when ready.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Shop" asp-action="Index" class="tv-btn-primary">
                        <i class="bi bi-compass me-2"></i> Explore Watches
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Wishlist Grid (Phase 2.7) -->
        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 position-relative" style="background: var(--tv-white); border: 1px solid var(--tv-border); border-radius: 10px; overflow: hidden; box-shadow: var(--tv-shadow-subtle); transition: var(--tv-transition);">
                        <!-- Remove button -->
                        <form asp-controller="Wishlist" asp-action="Remove" method="post" class="position-absolute top-0 end-0 m-3 z-index-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="watchId" value="@item.WatchId" />
                            <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm border p-2" title="Remove from wishlist" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-x-lg text-danger" style="font-size: 0.75rem;"></i>
                            </button>
                        </form>

                        <div class="p-4 text-center rounded-top" style="background: var(--tv-bg); aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center;">
                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.WatchId">
                                <img src="@item.ImageUrl" alt="@item.WatchName" class="img-fluid" style="max-height: 180px; object-fit: contain; transition: transform 0.3s ease;" />
                            </a>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <span class="badge bg-light text-muted border text-uppercase align-self-start mb-2" style="font-size: 0.65rem;">@item.BrandName</span>
                            <h5 class="card-title fw-bold mb-1" style="font-family: var(--tv-font-heading); font-size: 1.05rem;">
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.WatchId" class="text-decoration-none text-dark">
                                    @item.WatchName
                                </a>
                            </h5>
                            <div class="text-muted small mb-3">SKU: @item.SKU</div>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-baseline mb-3">
                                    <span class="fs-5 fw-bold" style="color: var(--tv-primary);">₹@item.Price.ToString("N0")</span>
                                    @if (item.InStock)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle small">In Stock (@item.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Sold Out</span>
                                    }
                                </div>

                                @if (item.InStock)
                                {
                                    <form asp-controller="Wishlist" asp-action="MoveToCart" method="post" class="d-grid">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="watchId" value="@item.WatchId" />
                                        <button type="submit" class="tv-btn-primary w-100" style="padding: 0.6rem 1rem; font-size: 0.8rem;">
                                            <i class="bi bi-bag-plus me-1"></i> Move to Cart
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100" disabled style="padding: 0.6rem 1rem; font-size: 0.8rem;">
                                        <i class="bi bi-bell me-1"></i> Out of Stock
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
