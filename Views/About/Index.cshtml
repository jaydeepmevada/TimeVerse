@{
    ViewData["Title"] = "Our Heritage & Philosophy — TIMEVERSE";
}

<!-- About Header Banner -->
<section class="tv-catalog-header">
    <div class="container-xl text-center">
        <span class="tv-section-tag">Haute Horlogerie Heritage</span>
        <h1 style="font-size: 3rem; color: #FFFFFF; margin-bottom: 0.8rem;">THE UNIVERSE OF TIME</h1>
        <p style="color: #A6A59E; max-width: 650px; margin: 0 auto; font-size: 1.1rem;">
            Time is not merely measured in ticks and seconds; it is sculpted into heirloom mechanical art that outlives generations.
        </p>
    </div>
</section>

<!-- Brand Philosophy & Split Section -->
<section class="tv-section-light">
    <div class="container-xl">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="tv-section-tag">The TimeVerse Story</span>
                <h2 class="tv-section-title" style="font-size: 2.6rem;">WHERE PASSION MEETS PRECISION</h2>
                <p style="font-size: 1.05rem; line-height: 1.8; color: #4A4A46;">
                    Founded with an unyielding reverence for mechanical purity, TimeVerse was born to curate the world’s most coveted horological creations under one prestigious umbrella.
                </p>
                <p style="font-size: 1rem; line-height: 1.8; color: #4A4A46;">
                    From the snowcapped valleys of the Swiss Jura mountains to the minimalist design ateliers of Tokyo and Ahmedabad, we unite collectors with authentic masterpieces that celebrate patience, human dexterity, and eternal craftsmanship.
                </p>
                <div class="d-flex gap-3 mt-4">
                    <a asp-controller="Watches" asp-action="Index" class="tv-btn-primary">
                        Explore Collection
                    </a>
                    <a asp-controller="Contact" asp-action="Index" class="tv-btn-outline">
                        Connect With Concierge
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="p-4 rounded" style="background: var(--tv-surface-dark); border: 2px solid var(--tv-accent-lime); color: var(--tv-white);">
                    <h3 style="color: var(--tv-accent-lime); font-size: 1.6rem; margin-bottom: 1.2rem;">Our Pillars of Trust</h3>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex align-items-start gap-3">
                            <i class="bi bi-patch-check-fill text-success" style="font-size: 1.5rem; color: var(--tv-accent-lime) !important;"></i>
                            <div>
                                <h5 class="text-white mb-1" style="font-size: 1rem;">100% Guaranteed Provenance</h5>
                                <p style="color: #A6A59E; font-size: 0.85rem; margin-bottom: 0;">Every serial number is authenticated against factory ledgers and official chronometer databases.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-3">
                            <i class="bi bi-shield-shaded text-success" style="font-size: 1.5rem; color: var(--tv-accent-lime) !important;"></i>
                            <div>
                                <h5 class="text-white mb-1" style="font-size: 1rem;">Direct Manufacturer Relationships</h5>
                                <p style="color: #A6A59E; font-size: 0.85rem; margin-bottom: 0;">We work directly with authorized distributors to provide valid international warranty coverage.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-3">
                            <i class="bi bi-gem text-success" style="font-size: 1.5rem; color: var(--tv-accent-lime) !important;"></i>
                            <div>
                                <h5 class="text-white mb-1" style="font-size: 1rem;">Archival Rare Allocations</h5>
                                <p style="color: #A6A59E; font-size: 0.85rem; margin-bottom: 0;">Access to limited production allocations and bespoke bespoke complications for discerning patrons.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
