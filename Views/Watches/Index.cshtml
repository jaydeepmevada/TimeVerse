@model TimeVerse.ViewModels.WatchListViewModel
@{
    ViewData["Title"] = "All Watches — TIMEVERSE";
}

<!-- Catalog Header Banner -->
<section class="tv-catalog-header" style="padding: 2.5rem 0 2rem;">
    <div class="container-xl">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <span class="tv-section-tag">Watch Store</span>
                <h1 style="font-size: 2.5rem; color: #FFFFFF; margin-bottom: 0.25rem;">ALL WATCHES</h1>
                <p style="color: #A6A59E; margin-bottom: 0;">
                    Showing @Model.Watches.Count of @Model.TotalItems available watches
                </p>
            </div>
            
            <!-- Quick Search Bar -->
            <form method="get" asp-controller="Watches" asp-action="Index" class="d-flex gap-2" style="max-width: 380px; width: 100%;">
                <input type="hidden" name="brand" value="@Model.Brand" />
                <input type="hidden" name="category" value="@Model.Category" />
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="text" name="search" value="@Model.Search" class="tv-input text-dark" placeholder="Search watch name, brand..." />
                <button type="submit" class="tv-btn-primary" style="padding: 0.65rem 1.2rem;">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
    </div>
</section>

<!-- Shop Body: Sidebar Filters & Product Grid -->
<section class="tv-section-light" style="padding: 2.5rem 0 4rem;">
    <div class="container-xl">
        <div class="row g-4">
            <!-- Left Sidebar Filter Form -->
            <div class="col-lg-3">
                <div class="tv-filter-card" style="background: var(--tv-white); border: 1px solid var(--tv-border); border-radius: 8px;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="tv-filter-title mb-0" style="font-weight: 700;">Filters</div>
                        <a asp-controller="Watches" asp-action="Index" class="text-muted small text-decoration-underline">Reset All</a>
                    </div>

                    <form method="get" asp-controller="Watches" asp-action="Index" id="tvFilterForm">
                        <input type="hidden" name="search" value="@Model.Search" />

                        <!-- Brand Filter -->
                        <div class="tv-filter-group">
                            <div class="tv-filter-group-title">Brand</div>
                            <select name="brand" class="tv-select w-100" onchange="this.form.submit()">
                                <option value="">All Brands</option>
                                @foreach (var b in Model.FilterOptions.Brands)
                                {
                                    <option value="@b" selected="@(Model.Brand == b)">@b</option>
                                }
                            </select>
                        </div>

                        <!-- Category Filter -->
                        <div class="tv-filter-group">
                            <div class="tv-filter-group-title">Category</div>
                            <select name="category" class="tv-select w-100" onchange="this.form.submit()">
                                <option value="">All Categories</option>
                                @foreach (var c in Model.FilterOptions.Categories)
                                {
                                    <option value="@c" selected="@(Model.Category == c)">@c</option>
                                }
                            </select>
                        </div>

                        <!-- Movement Filter -->
                        <div class="tv-filter-group">
                            <div class="tv-filter-group-title">Watch Type / Movement</div>
                            <select name="movement" class="tv-select w-100" onchange="this.form.submit()">
                                <option value="">All Types</option>
                                @foreach (var m in Model.FilterOptions.Movements)
                                {
                                    <option value="@m" selected="@(Model.Movement == m)">@m</option>
                                }
                            </select>
                        </div>

                        <!-- Gender Filter -->
                        <div class="tv-filter-group">
                            <div class="tv-filter-group-title">Gender</div>
                            <select name="gender" class="tv-select w-100" onchange="this.form.submit()">
                                <option value="">All Genders</option>
                                @foreach (var g in Model.FilterOptions.Genders)
                                {
                                    <option value="@g" selected="@(Model.Gender == g)">@g</option>
                                }
                            </select>
                        </div>

                        <!-- Stock Status -->
                        <div class="tv-filter-group">
                            <div class="tv-filter-group-title">Stock Status</div>
                            <select name="stockFilter" class="tv-select w-100" onchange="this.form.submit()">
                                <option value="" selected="@(string.IsNullOrEmpty(Model.StockFilter))">All Statuses</option>
                                <option value="inStock" selected="@(Model.StockFilter == "inStock")">In Stock Only</option>
                                <option value="outOfStock" selected="@(Model.StockFilter == "outOfStock")">Sold Out</option>
                            </select>
                        </div>

                        <!-- Price Range -->
                        <div class="tv-filter-group">
                            <div class="tv-filter-group-title">Price Range (₹)</div>
                            <div class="d-flex gap-2 align-items-center mb-2">
                                <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="Min" class="tv-input" style="padding: 0.5rem;" />
                                <span>-</span>
                                <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="Max" class="tv-input" style="padding: 0.5rem;" />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="tv-btn-dark" style="padding: 0.65rem;">
                                <i class="bi bi-funnel"></i> Apply Filters
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Right Products Grid -->
            <div class="col-lg-9">
                <!-- Sorting & Top Summary Bar -->
                <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-3 mb-4 rounded" 
                     style="background: var(--tv-white); border: 1px solid var(--tv-border);">
                    <div style="font-size: 0.9rem; font-weight: 600;">
                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <span>Search results for &ldquo;<strong>@Model.Search</strong>&rdquo;</span>
                        }
                        else
                        {
                            <span>Page @Model.CurrentPage of @(Model.TotalPages > 0 ? Model.TotalPages : 1)</span>
                        }
                    </div>

                    <!-- Sort Dropdown -->
                    <div class="d-flex align-items-center gap-2">
                        <label for="tvSortSelect" style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--tv-muted); white-space: nowrap;">Sort By:</label>
                        <select id="tvSortSelect" class="tv-select" style="padding: 0.45rem 0.9rem; font-size: 0.82rem;"
                                onchange="location.href = updateQueryString('sort', this.value);">
                            <option value="featured" selected="@(Model.Sort == "featured")">Featured Watches</option>
                            <option value="newest" selected="@(Model.Sort == "newest")">Newest Arrivals</option>
                            <option value="priceAsc" selected="@(Model.Sort == "priceAsc")">Price: Low to High</option>
                            <option value="priceDesc" selected="@(Model.Sort == "priceDesc")">Price: High to Low</option>
                            <option value="rating" selected="@(Model.Sort == "rating")">Highest Rated</option>
                            <option value="bestSeller" selected="@(Model.Sort == "bestSeller")">Best Sellers</option>
                        </select>
                    </div>
                </div>

                <!-- Products Grid / Empty State -->
                @if (Model.Watches.Any())
                {
                    <div class="row g-4">
                        @foreach (var watch in Model.Watches)
                        {
                            <div class="col-md-6 col-xl-4">
                                <partial name="_WatchCard" model="watch" />
                            </div>
                        }
                    </div>

                    <!-- Server-side Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <div class="tv-pagination">
                            <a class="tv-page-btn @(!Model.HasPreviousPage ? "disabled" : "")"
                               href="@Url.Action("Index", new {
                                   page = Model.CurrentPage - 1,
                                   search = Model.Search,
                                   brand = Model.Brand,
                                   category = Model.Category,
                                   movement = Model.Movement,
                                   gender = Model.Gender,
                                   minPrice = Model.MinPrice,
                                   maxPrice = Model.MaxPrice,
                                   stockFilter = Model.StockFilter,
                                   sort = Model.Sort
                               })">
                                <i class="bi bi-chevron-left"></i>
                            </a>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <a class="tv-page-btn @(p == Model.CurrentPage ? "active" : "")"
                                   href="@Url.Action("Index", new {
                                       page = p,
                                       search = Model.Search,
                                       brand = Model.Brand,
                                       category = Model.Category,
                                       movement = Model.Movement,
                                       gender = Model.Gender,
                                       minPrice = Model.MinPrice,
                                       maxPrice = Model.MaxPrice,
                                       stockFilter = Model.StockFilter,
                                       sort = Model.Sort
                                   })">
                                    @p
                                </a>
                            }

                            <a class="tv-page-btn @(!Model.HasNextPage ? "disabled" : "")"
                               href="@Url.Action("Index", new {
                                   page = Model.CurrentPage + 1,
                                   search = Model.Search,
                                   brand = Model.Brand,
                                   category = Model.Category,
                                   movement = Model.Movement,
                                   gender = Model.Gender,
                                   minPrice = Model.MinPrice,
                                   maxPrice = Model.MaxPrice,
                                   stockFilter = Model.StockFilter,
                                   sort = Model.Sort
                               })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <!-- Friendly Empty State -->
                    <div class="text-center p-5 rounded luxury-card" style="background: var(--tv-white);">
                        <div style="font-size: 3rem; margin-bottom: 0.5rem; color: var(--tv-muted);"><i class="bi bi-search"></i></div>
                        <h3 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 0.5rem;">No Watches Found</h3>
                        <p style="color: var(--tv-muted); max-width: 450px; margin: 0 auto 1.5rem;">
                            We couldn't find any watches matching your filters. Try searching for something else or clear the filters.
                        </p>
                        <a asp-controller="Watches" asp-action="Index" class="tv-btn-primary" style="padding: 0.65rem 1.4rem;">
                            Clear All Filters
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function updateQueryString(key, value) {
            const url = new URL(window.location.href);
            url.searchParams.set(key, value);
            url.searchParams.set('page', '1');
            return url.toString();
        }
    </script>
}
