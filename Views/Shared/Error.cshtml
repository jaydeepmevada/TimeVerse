@model ErrorViewModel
@{
    ViewData["Title"] = "System Notice — TIMEVERSE";
}

<section class="tv-section-light" style="padding: 6rem 0;">
    <div class="container-xl text-center">
        <div class="p-5 rounded mx-auto" style="max-width: 650px; background: var(--tv-white); border: 1px solid var(--tv-border); box-shadow: var(--tv-shadow-subtle);">
            <div style="font-size: 3.5rem; color: var(--tv-accent-lime); margin-bottom: 1rem;">
                <i class="bi bi-clock-history"></i>
            </div>
            <span class="tv-section-tag">Horological Anomaly</span>
            <h1 style="font-size: 2.2rem; margin-bottom: 0.75rem;">Time Stands Still</h1>
            <p style="color: var(--tv-muted); font-size: 1rem; line-height: 1.7; margin-bottom: 2rem;">
                An unexpected perturbation occurred while processing your request. Our horology systems have logged the event.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="p-2 mb-4 rounded" style="background: var(--tv-cream-soft); font-size: 0.8rem; color: var(--tv-primary-dark);">
                    <strong>Diagnostic Reference Trace:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="tv-btn-primary">
                    <i class="bi bi-house-door"></i> Return to Homepage
                </a>
                <a asp-controller="Watches" asp-action="Index" class="tv-btn-dark">
                    <i class="bi bi-watch"></i> Browse Collection
                </a>
            </div>
        </div>
    </div>
</section>
