@{
    ViewData["Title"] = "Restricted Access — TIMEVERSE";
}

<section class="tv-section-dark" style="min-height: 70vh; display: flex; align-items: center; background: radial-gradient(circle at center, #262623 0%, #151514 100%);">
    <div class="container-xl text-center">
        <div class="p-5 rounded mx-auto" style="max-width: 600px; background: rgba(36, 36, 34, 0.9); border: 1px solid rgba(220, 53, 69, 0.4); box-shadow: 0 20px 40px rgba(0,0,0,0.6);">
            <div style="font-size: 3.5rem; color: #ff6b6b; margin-bottom: 1rem;">
                <i class="bi bi-shield-x"></i>
            </div>
            <span class="tv-section-tag" style="color: #ff8585;">Security Boundary 403</span>
            <h1 style="font-size: 2.2rem; color: #FFFFFF; margin-bottom: 0.75rem;">Access Restricted</h1>
            <p style="color: #C8C6BC; font-size: 1rem; line-height: 1.7; margin-bottom: 2rem;">
                Your account does not possess the requisite security clearance to access this sector of the TimeVerse portal.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="tv-btn-primary">
                    Return to Showcase
                </a>
                <a asp-controller="Account" asp-action="Login" class="tv-btn-outline-light">
                    Switch Account
                </a>
            </div>
        </div>
    </div>
</section>
