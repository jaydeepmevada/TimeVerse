@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container-xl py-5" style="margin-top: 40px;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h2 fw-bold mb-4" style="color: var(--tv-primary);">Privacy Policy</h1>
            <div class="bg-white p-4 rounded shadow-sm border">
                <h5 class="fw-bold mb-2">Information We Collect</h5>
                <p class="text-muted mb-4">
                    TimeVerse collects customer account information including name, email, and shipping address solely for fulfillment and communication.
                </p>

                <h5 class="fw-bold mb-2">Data Protection</h5>
                <p class="text-muted mb-4">
                    We employ industry-standard encryption and security practices to ensure your personal data is protected against unauthorized access.
                </p>

                <h5 class="fw-bold mb-2">Cookies &amp; Sessions</h5>
                <p class="text-muted mb-0">
                    We use essential session cookies to manage authentication, shopping carts, and security tokens.
                </p>
            </div>
        </div>
    </div>
</div>
