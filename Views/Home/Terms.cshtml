@{
    ViewData["Title"] = "Terms & Conditions";
}

<div class="container-xl py-5" style="margin-top: 40px;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h2 fw-bold mb-4" style="color: var(--tv-primary);">Terms &amp; Conditions</h1>
            <div class="bg-white p-4 rounded shadow-sm border">
                <h5 class="fw-bold mb-2">1. Authenticity Guarantee</h5>
                <p class="text-muted mb-4">
                    All watches sold through TimeVerse are guaranteed 100% genuine and sourced directly from authorized brand partners. Each timepiece includes manufacturer documentation and warranty cards.
                </p>

                <h5 class="fw-bold mb-2">2. Orders &amp; Delivery</h5>
                <p class="text-muted mb-4">
                    Orders are processed upon verification. Delivery timelines depend on location, typically ranging between 2 to 5 business days with insured courier tracking.
                </p>

                <h5 class="fw-bold mb-2">3. Return Policy</h5>
                <p class="text-muted mb-0">
                    TimeVerse provides a 14-day return and exchange window for unworn timepieces in their original packaging and security seals intact.
                </p>
            </div>
        </div>
    </div>
</div>
