@model List<TimeVerse.ViewModels.Customer.AddressViewModel>
@{
    ViewData["Title"] = "Shipping Address Book — TIMEVERSE";
    var newAddress = new TimeVerse.ViewModels.Customer.AddressViewModel();
}

<section class="tv-catalog-header" style="padding: 2.5rem 0 2rem;">
    <div class="container-xl">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <span class="tv-section-tag">Logistics & Delivery</span>
                <h1 style="font-size: 2.2rem; color: #FFFFFF; margin-bottom: 0.25rem;">SHIPPING ADDRESS BOOK</h1>
                <p style="color: #A6A59E; margin-bottom: 0;">Manage your verified armored delivery points across India and internationally.</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="tv-btn-primary" data-bs-toggle="modal" data-bs-target="#addAddressModal" style="padding: 0.5rem 1.2rem;">
                    <i class="bi bi-plus-lg"></i> Add New Address
                </button>
                <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="tv-btn-outline-light" style="padding: 0.5rem 1rem;">
                    <i class="bi bi-arrow-left"></i> Dashboard
                </a>
            </div>
        </div>
    </div>
</section>

<section class="tv-section-light" style="padding: 3rem 0 5rem;">
    <div class="container-xl">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success p-3 rounded mb-4">
                <i class="bi bi-check-circle-fill text-success me-1"></i>
                <strong>@TempData["SuccessMessage"]</strong>
            </div>
        }

        <div class="row g-4">
            @if (Model.Any())
            {
                @foreach (var addr in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="p-4 rounded h-100 position-relative" style="background: var(--tv-white); border: 1px solid var(--tv-border); box-shadow: var(--tv-shadow-subtle);">
                            @if (addr.IsDefault)
                            {
                                <span class="badge bg-dark text-white position-absolute" style="top: 15px; right: 15px;">Default Destination</span>
                            }

                            <h5 style="font-size: 1.1rem; margin-bottom: 0.35rem;">@addr.FullName</h5>
                            <div class="text-muted mb-2" style="font-size: 0.85rem;"><i class="bi bi-telephone"></i> @addr.Phone</div>

                            <p style="font-size: 0.9rem; color: #4A4A46; line-height: 1.6; margin-bottom: 1.5rem;">
                                @addr.AddressLine1<br />
                                @if (!string.IsNullOrEmpty(addr.AddressLine2))
                                {
                                    <span>@addr.AddressLine2<br /></span>
                                }
                                @addr.City, @addr.State &ndash; <strong>@addr.PostalCode</strong><br />
                                @addr.Country
                            </p>

                            <div class="d-flex gap-2 pt-2 border-top">
                                <form method="post" asp-area="Customer" asp-controller="Profile" asp-action="DeleteAddress" asp-route-id="@addr.Id" onsubmit="return confirm('Remove this shipping destination?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 0.78rem;">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5 rounded" style="background: var(--tv-white); border: 1px dashed var(--tv-border);">
                        <div style="font-size: 3rem; color: var(--tv-muted); margin-bottom: 0.5rem;"><i class="bi bi-geo-alt"></i></div>
                        <h5>No Addresses Registered</h5>
                        <p class="text-muted">Add your primary residence or secure vault address for insured dispatches.</p>
                        <button type="button" class="tv-btn-primary" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                            Add First Destination
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Add Address Modal -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-labelledby="addAddressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: var(--tv-white); border-radius: 8px;">
            <div class="modal-header" style="background: var(--tv-primary-dark); color: #FFF; border-bottom: 2px solid var(--tv-accent);">
                <h5 class="modal-title" id="addAddressModalLabel"><i class="bi bi-geo-alt-fill text-warning" style="color: var(--tv-accent) !important;"></i> Add New Delivery Destination</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-area="Customer" asp-controller="Profile" asp-action="AddAddress">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="@newAddress.FullName" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                            <input name="FullName" required class="tv-input" placeholder="e.g. Jimit Shah" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="@newAddress.Phone" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                            <input name="Phone" required class="tv-input" placeholder="+91 98000 00000" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="@newAddress.AddressLine1" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                        <input name="AddressLine1" required class="tv-input" placeholder="Apartment / Villa / Street Name" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="@newAddress.AddressLine2" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                        <input name="AddressLine2" class="tv-input" placeholder="Landmark / Suite (Optional)" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="@newAddress.City" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                            <input name="City" required class="tv-input" placeholder="e.g. Ahmedabad" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="@newAddress.State" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                            <input name="State" required class="tv-input" placeholder="e.g. Gujarat" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="@newAddress.PostalCode" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                            <input name="PostalCode" required class="tv-input" placeholder="e.g. 380054" />
                        </div>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" name="IsDefault" value="true" class="form-check-input" id="checkDefaultAddr" />
                        <label class="form-check-label fw-semibold" for="checkDefaultAddr">Set as default destination for upcoming consignments</label>
                    </div>
                </div>
                <div class="modal-footer" style="background: var(--tv-cream-soft);">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="tv-btn-primary">Save Destination</button>
                </div>
            </form>
        </div>
    </div>
</div>
