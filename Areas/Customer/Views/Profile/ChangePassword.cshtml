@model TimeVerse.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Update Vault Password — TIMEVERSE";
}

<section class="tv-catalog-header" style="padding: 2.5rem 0 2rem;">
    <div class="container-xl">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <span class="tv-section-tag">Security Governance</span>
                <h1 style="font-size: 2.2rem; color: #FFFFFF; margin-bottom: 0.25rem;">CHANGE PASSWORD</h1>
                <p style="color: #A6A59E; margin-bottom: 0;">Update your authentication credentials with high-entropy cryptographic encryption.</p>
            </div>
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="tv-btn-outline-light" style="padding: 0.5rem 1rem;">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>
</section>

<section class="tv-section-light" style="padding: 3rem 0 5rem;">
    <div class="container-xl">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="p-4 p-md-5 rounded" style="background: var(--tv-white); border: 1px solid var(--tv-border); box-shadow: var(--tv-shadow-subtle);">
                    @if (Model.Succeeded)
                    {
                        <div class="alert alert-success p-3 rounded mb-4">
                            <i class="bi bi-shield-check text-success me-1"></i>
                            <strong>@Model.Message</strong>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 mb-3" style="font-size: 0.85rem;"></div>

                    <form method="post" asp-area="Customer" asp-controller="Profile" asp-action="ChangePassword">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                            <input asp-for="CurrentPassword" class="tv-input" placeholder="••••••••" />
                            <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                            <input asp-for="NewPassword" class="tv-input" placeholder="••••••••" />
                            <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-bold" style="font-size: 0.8rem; text-transform: uppercase; color: var(--tv-muted);"></label>
                            <input asp-for="ConfirmNewPassword" class="tv-input" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <button type="submit" class="tv-btn-primary w-100" style="padding: 0.85rem;">
                            <i class="bi bi-key-fill"></i> Update Security Credentials
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
