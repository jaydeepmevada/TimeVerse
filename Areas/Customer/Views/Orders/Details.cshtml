@model TimeVerse.ViewModels.Orders.OrderDetailsViewModel
@{
    ViewData["Title"] = "Acquisition #" + Model.OrderNumber + " — TimeVerse";
}

<div class="luxury-container py-5">
    <nav class="breadcrumb-nav mb-4" aria-label="breadcrumb">
        <a asp-controller="Home" asp-action="Index">TimeVerse</a>
        <span class="separator">/</span>
        <a asp-area="Customer" asp-controller="Orders" asp-action="Index">My Acquisitions</a>
        <span class="separator">/</span>
        <span class="current">#@Model.OrderNumber</span>
    </nav>

    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3 flex-wrap gap-3">
        <div>
            <span class="badge-accent mb-2">Acquisition Record</span>
            <h1 class="display-5 fw-bold font-serif mb-0">Order Reference #@Model.OrderNumber</h1>
            <p class="text-muted mb-0">Placed on @Model.OrderDate.ToString("dd MMMM yyyy, hh:mm tt") UTC</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Customer" asp-controller="Orders" asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-dark">
                <i class="bi bi-printer me-1"></i> Download Tax Invoice
            </a>
            <a asp-area="Customer" asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Acquisitions
            </a>
        </div>
    </div>

    <!-- Status Tracking Timeline -->
    <div class="card bg-charcoal text-white p-4 rounded-4 mb-4 border-0 shadow-sm">
        <div class="row align-items-center">
            <div class="col-md-6">
                <span class="badge-accent mb-2">Vault Ledger Status</span>
                <h4 class="font-serif fw-bold text-white mb-1">
                    @switch (Model.Status)
                    {
                        case TimeVerse.Models.OrderStatus.Pending:
                            <span>Acquisition Received — Verification in Progress</span>
                            break;
                        case TimeVerse.Models.OrderStatus.Confirmed:
                            <span>Vault Confirmed — Allocating Physical Watch</span>
                            break;
                        case TimeVerse.Models.OrderStatus.Processing:
                            <span>White-Glove Vault Inspection & Laser Sealed</span>
                            break;
                        case TimeVerse.Models.OrderStatus.Shipped:
                            <span>Dispatched via Armored Insured Courier</span>
                            break;
                        case TimeVerse.Models.OrderStatus.Delivered:
                            <span>Delivered & Handed to Patron</span>
                            break;
                        case TimeVerse.Models.OrderStatus.Cancelled:
                            <span class="text-danger">Acquisition Cancelled & Vault Inventory Restored</span>
                            break;
                    }
                </h4>
                <div class="text-cream-muted small">Tracking Reference: <strong class="text-accent font-monospace">@Model.TrackingNumber</strong></div>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <span class="badge bg-dark border border-secondary px-3 py-2 fs-6">
                    Payment: @Model.PaymentMethod (@Model.PaymentStatus)
                </span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Items Breakdown -->
        <div class="col-lg-8">
            <div class="card luxury-card mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="font-serif fw-bold mb-0">Acquired Timepieces</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Timepiece Reference</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Unit Valuation</th>
                                <th class="text-end">Total</th>
                                @if (Model.Status == TimeVerse.Models.OrderStatus.Delivered)
                                {
                                    <th class="text-center">Review</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@item.ImageUrl" alt="@item.WatchName" class="rounded border" style="width: 55px; height: 55px; object-fit: cover;" />
                                            <div>
                                                <h6 class="font-serif fw-bold mb-0">
                                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.WatchId" class="text-decoration-none text-dark">
                                                        @item.WatchName
                                                    </a>
                                                </h6>
                                                <small class="text-muted font-monospace">SKU: @item.SKU</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center fw-bold">@item.Quantity</td>
                                    <td class="text-end">₹@item.UnitPrice.ToString("N0")</td>
                                    <td class="text-end fw-bold font-serif">₹@item.TotalPrice.ToString("N0")</td>
                                    @if (Model.Status == TimeVerse.Models.OrderStatus.Delivered)
                                    {
                                        <td class="text-center">
                                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.WatchId" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-star me-1"></i> Review
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Subtotal:</td>
                                <td class="text-end fw-bold">₹@Model.TotalAmount.ToString("N0")</td>
                                @if (Model.Status == TimeVerse.Models.OrderStatus.Delivered) { <td></td> }
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Armored Courier:</td>
                                <td class="text-end">
                                    @(Model.ShippingFee == 0 ? "Complimentary" : $"₹{Model.ShippingFee:N0}")
                                </td>
                                @if (Model.Status == TimeVerse.Models.OrderStatus.Delivered) { <td></td> }
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold font-serif fs-6">Settled Grand Total:</td>
                                <td class="text-end fw-bold font-serif fs-5 text-dark">₹@Model.FinalAmount.ToString("N0")</td>
                                @if (Model.Status == TimeVerse.Models.OrderStatus.Delivered) { <td></td> }
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right: Destination Details -->
        <div class="col-lg-4">
            <div class="card luxury-card p-4">
                <h5 class="font-serif fw-bold mb-3 border-bottom pb-2">Delivery Destination</h5>
                <div class="fw-bold fs-6 mb-1">@Model.ShippingFullName</div>
                <div class="text-muted small mb-3">
                    <div>@Model.ShippingAddressLine1</div>
                    @if (!string.IsNullOrEmpty(Model.ShippingAddressLine2))
                    {
                        <div>@Model.ShippingAddressLine2</div>
                    }
                    <div>@Model.ShippingCity, @Model.ShippingState — @Model.ShippingPostalCode</div>
                    <div>@Model.ShippingCountry</div>
                    <div class="mt-2"><i class="bi bi-telephone me-1"></i> @Model.ShippingPhone</div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="border-top pt-3">
                        <span class="text-muted small text-uppercase fw-bold">Dispatch Instructions:</span>
                        <p class="small text-muted mb-0 mt-1">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
