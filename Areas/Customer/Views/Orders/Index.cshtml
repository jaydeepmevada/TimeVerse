@model List<TimeVerse.ViewModels.Orders.OrderSummaryViewModel>
@{
    ViewData["Title"] = "My Orders — TIMEVERSE";
}

<div class="luxury-container py-5">
    <nav class="breadcrumb-nav mb-4" aria-label="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="separator">/</span>
        <a asp-area="Customer" asp-controller="Home" asp-action="Index">My Account</a>
        <span class="separator">/</span>
        <span class="current">My Orders</span>
    </nav>

    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3 flex-wrap gap-3">
        <div>
            <span class="badge bg-dark text-white mb-2 d-inline-block px-3 py-1">Order History</span>
            <h1 class="display-6 fw-bold mb-0">My Orders</h1>
            <p class="text-muted mb-0">Track your watch orders, check live delivery status, and download receipts.</p>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="tv-btn-primary">
            <i class="bi bi-shop me-1"></i> Shop More Watches
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="p-5 luxury-card text-center my-4" style="background: var(--tv-white);">
            <div class="card-body">
                <div style="font-size: 3rem; margin-bottom: 0.5rem; color: var(--tv-muted);"><i class="bi bi-box-seam"></i></div>
                <h3 class="fw-bold mb-2">No Orders Found Yet</h3>
                <p class="text-muted max-w-md mx-auto mb-4">
                    You haven't placed any orders yet. Browse our watch collection to find the right one for you.
                </p>
                <a asp-controller="Shop" asp-action="Index" class="tv-btn-primary" style="padding: 0.75rem 1.6rem;">
                    <i class="bi bi-cart-plus me-1"></i> Browse Watches
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="luxury-card p-3" style="background: var(--tv-white);">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th class="text-center">Items</th>
                            <th class="text-end">Total Price</th>
                            <th class="text-center">Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold fs-6">@o.OrderNumber</div>
                                    <small class="text-muted">Paid via: @o.PaymentMethod</small>
                                </td>
                                <td>
                                    <div>@o.OrderDate.ToString("dd MMMM yyyy")</div>
                                    <small class="text-muted">@o.OrderDate.ToString("hh:mm tt")</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border" style="font-size: 0.75rem; padding: 3px 8px;">@o.ItemCount @(o.ItemCount == 1 ? "watch" : "watches")</span>
                                </td>
                                <td class="text-end fw-bold fs-6">
                                    ₹@o.FinalAmount.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @switch (o.Status)
                                    {
                                        case TimeVerse.Models.OrderStatus.Pending:
                                            <span class="tv-status-badge tv-status-pending">Pending</span>
                                            break;
                                        case TimeVerse.Models.OrderStatus.Confirmed:
                                            <span class="tv-status-badge tv-status-confirmed">Confirmed</span>
                                            break;
                                        case TimeVerse.Models.OrderStatus.Processing:
                                            <span class="tv-status-badge tv-status-processing">Packing</span>
                                            break;
                                        case TimeVerse.Models.OrderStatus.Shipped:
                                            <span class="tv-status-badge tv-status-shipped">Shipped</span>
                                            break;
                                        case TimeVerse.Models.OrderStatus.Delivered:
                                            <span class="tv-status-badge tv-status-delivered">Delivered</span>
                                            break;
                                        case TimeVerse.Models.OrderStatus.Cancelled:
                                            <span class="tv-status-badge tv-status-cancelled">Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-area="Customer" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-dark" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-area="Customer" asp-controller="Orders" asp-action="Invoice" asp-route-id="@o.Id" target="_blank" class="btn btn-sm btn-dark" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;" title="View Invoice">
                                            <i class="bi bi-printer"></i> Invoice
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
