@model List<TimeVerse.ViewModels.Admin.BrandCrudViewModel>
@{
    ViewData["Title"] = "Horology Brands — Admin";
}

<!-- Admin Console Header -->
<section class="tv-catalog-header" style="padding: 2rem 0 1.5rem;">
    <div class="container-xl">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <span class="tv-badge tv-badge-lime mb-2">Watchmakers</span>
                <h1 style="font-size: 2.2rem; color: #FFFFFF; margin-bottom: 0.25rem;">MANUFACTURER BRANDS</h1>
                <p style="color: #A6A59E; margin-bottom: 0;">Manage prestigious horology maisons, manufacturers, and ateliers.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="Brands" asp-action="Create" class="tv-btn-primary" style="padding: 0.55rem 1.1rem;">
                    <i class="bi bi-plus-lg me-1"></i> Add Brand
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Admin Navigation Bar -->
<div class="tv-dashboard-bar">
    <div class="container-xl">
        <div class="tv-dashboard-nav">
            <a asp-area="@(User.IsInRole(TimeVerse.Data.RoleConstants.Admin) ? "Admin" : "Sales")" asp-controller="Dashboard" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-speedometer2"></i> Overview</a>
            <a asp-area="Admin" asp-controller="Watches" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-watch"></i> Watches</a>
            <a asp-area="Admin" asp-controller="Brands" asp-action="Index" class="tv-dashboard-link active"><i class="bi bi-building"></i> Brands</a>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-tags"></i> Categories</a>
            <a asp-area="@(User.IsInRole(TimeVerse.Data.RoleConstants.Admin) ? "Admin" : "Sales")" asp-controller="Orders" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-box-seam"></i> Orders</a>
            @if (User.IsInRole(TimeVerse.Data.RoleConstants.Admin))
            {
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-people"></i> Users</a>
            }
            <a asp-area="" asp-controller="Home" asp-action="Index" class="tv-dashboard-link text-white ms-auto"><i class="bi bi-box-arrow-up-right"></i> View Storefront</a>
        </div>
    </div>
</div>

<section class="tv-section-light" style="padding: 2.5rem 0 4.5rem;">
    <div class="container-xl">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4 border" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="luxury-card p-0" style="background: var(--tv-white); overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="padding-left: 1.25rem; width: 220px;">Brand Maison</th>
                            <th>Heritage & Description</th>
                            <th class="text-center" style="width: 140px;">Timepieces</th>
                            <th class="text-center" style="width: 120px;">Status</th>
                            <th class="text-end" style="padding-right: 1.25rem; width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr class="@(!b.IsActive ? "table-secondary text-muted" : "")">
                                <td style="padding-left: 1.25rem;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div style="width: 48px; height: 36px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 6px; display: flex; align-items: center; justify-content: center; padding: 4px;">
                                            @{
                                                var bLogo = b.Name.ToLower() switch
                                                {
                                                    "fastrack" => "/images/brands/fastrack.png",
                                                    "fossil" => "/images/brands/fossil.png",
                                                    "titan" => "/images/brands/titan.png",
                                                    "seiko" => "/images/brands/seiko.png",
                                                    "citizen" => "/images/brands/citizen.png",
                                                    "rolex" => "/images/brands/rolex.svg",
                                                    "omega" => "/images/brands/omega.svg",
                                                    "casio" => "/images/brands/casio.svg",
                                                    "tissot" => "/images/brands/tissot.svg",
                                                    _ => $"/images/brands/{b.Name.ToLower()}.svg"
                                                };
                                            }
                                            <img src="@bLogo" alt="@b.Name" style="max-height: 100%; max-width: 100%; object-fit: contain;" onerror="this.style.display='none'" />
                                        </div>
                                        <div>
                                            <div class="fw-bold fs-6">@b.Name</div>
                                            <small class="text-muted">ID: #@b.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-muted small">@b.Description</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@b.WatchCount timepiece(s)</span>
                                </td>
                                <td class="text-center">
                                    @if (b.IsActive)
                                    {
                                        <span class="badge bg-success px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end" style="padding-right: 1.25rem;">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-area="Admin" asp-controller="Brands" asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-dark" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;" title="Edit">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>

                                        <form asp-area="Admin" asp-controller="Brands" asp-action="ToggleStatus" asp-route-id="@b.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(b.IsActive ? "btn-outline-warning" : "btn-outline-success")" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;" title="@(b.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(b.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                                @(b.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>

                                        <form asp-area="Admin" asp-controller="Brands" asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;" title="Delete brand"
                                                    onclick="return confirm('Permanently delete brand @b.Name? (Protected: cannot delete if watches belong to it)');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
