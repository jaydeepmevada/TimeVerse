@model TimeVerse.ViewModels.Admin.AdminReviewListViewModel
@{
    ViewData["Title"] = "Customer Reviews Moderation — Admin";
}

<!-- Admin Console Header -->
<section class="tv-catalog-header" style="padding: 2rem 0 1.5rem;">
    <div class="container-xl">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <span class="tv-badge tv-badge-lime mb-2">Reputation & Feedback</span>
                <h1 style="font-size: 2.2rem; color: #FFFFFF; margin-bottom: 0.25rem;">CUSTOMER REVIEWS</h1>
                <p style="color: #A6A59E; margin-bottom: 0;">Moderate collector feedback, verified purchaser reviews, and star ratings.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="tv-btn-outline-light" style="padding: 0.55rem 1.1rem;">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Admin Navigation Bar -->
<div class="tv-dashboard-bar">
    <div class="container-xl">
        <div class="tv-dashboard-nav">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-speedometer2"></i> Overview</a>
            <a asp-area="Admin" asp-controller="Watches" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-watch"></i> Watches</a>
            <a asp-area="Admin" asp-controller="Brands" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-building"></i> Brands</a>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-tags"></i> Categories</a>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-box-seam"></i> Orders</a>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-people"></i> Users</a>
            <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="tv-dashboard-link active"><i class="bi bi-chat-heart"></i> Reviews</a>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="tv-dashboard-link text-white ms-auto"><i class="bi bi-box-arrow-up-right"></i> View Storefront</a>
        </div>
    </div>
</div>

<section class="tv-section-light" style="padding: 2.5rem 0 4.5rem;">
    <div class="container-xl">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Status Filter Pills -->
        <div class="d-flex flex-wrap gap-2 mb-4">
            <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" asp-route-search="@Model.Search"
               class="btn btn-sm @(!Model.ApprovalFilter.HasValue ? "btn-dark text-white" : "btn-outline-dark")" style="border-radius: 20px; padding: 0.35rem 0.9rem;">
                All Reviews <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
            </a>
            <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" asp-route-isApproved="true" asp-route-search="@Model.Search"
               class="btn btn-sm @(Model.ApprovalFilter == true ? "btn-success text-white" : "btn-outline-success")" style="border-radius: 20px; padding: 0.35rem 0.9rem;">
                Approved <span class="badge bg-success text-white ms-1">@Model.ApprovedCount</span>
            </a>
            <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" asp-route-isApproved="false" asp-route-search="@Model.Search"
               class="btn btn-sm @(Model.ApprovalFilter == false ? "btn-warning text-dark" : "btn-outline-warning text-dark")" style="border-radius: 20px; padding: 0.35rem 0.9rem;">
                Pending Moderation <span class="badge bg-warning text-dark ms-1">@Model.PendingCount</span>
            </a>
        </div>

        <!-- Search Toolbar -->
        <div class="luxury-card p-3 mb-4" style="background: var(--tv-white);">
            <form method="get" asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="row g-2 align-items-center">
                @if (Model.ApprovalFilter.HasValue)
                {
                    <input type="hidden" name="isApproved" value="@Model.ApprovalFilter.Value" />
                }
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.Search" class="form-control border-start-0" placeholder="Search by watch name, reviewer, email, or comment..." />
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="tv-btn-primary w-100 py-2">Search</button>
                    @if (!string.IsNullOrEmpty(Model.Search) || Model.ApprovalFilter.HasValue)
                    {
                        <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </form>
        </div>

        <!-- Reviews Table -->
        <div class="luxury-card p-0" style="background: var(--tv-white); overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="padding-left: 1.25rem;">Watch Model</th>
                            <th>Reviewer</th>
                            <th class="text-center">Rating</th>
                            <th>Feedback / Assessment</th>
                            <th class="text-center">Status</th>
                            <th>Date</th>
                            <th class="text-end" style="padding-right: 1.25rem;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Reviews.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-chat-square-text display-4 d-block mb-2"></i>
                                    No customer reviews found matching your search.
                                </td>
                            </tr>
                        }
                        @foreach (var r in Model.Reviews)
                        {
                            <tr>
                                <td style="padding-left: 1.25rem;">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@r.WatchImageUrl" alt="@r.WatchName" style="width: 44px; height: 44px; object-fit: contain; border-radius: 4px; background: #fafafa; border: 1px solid #eee;" />
                                        <div>
                                            <div class="fw-bold small">@r.WatchName</div>
                                            <span class="font-monospace text-muted small" style="font-size: 0.72rem;">@r.WatchSKU</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold small">@r.UserName</div>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">@r.UserEmail</small>
                                    @if (r.IsVerifiedPurchase)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.65rem; padding: 2px 6px;">
                                            <i class="bi bi-patch-check-fill me-1"></i>Verified Buyer
                                        </span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <i class="bi bi-star-fill @(s <= r.Rating ? "text-warning" : "text-muted")" style="font-size: 0.85rem;"></i>
                                    }
                                </td>
                                <td style="max-width: 320px;">
                                    <p class="mb-0 small text-truncate" style="max-width: 300px;" title="@r.Comment">@r.Comment</p>
                                </td>
                                <td class="text-center">
                                    @if (r.IsApproved)
                                    {
                                        <span class="badge bg-success px-2 py-1">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">Pending</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@r.CreatedAt.ToString("dd MMM yyyy")</small>
                                </td>
                                <td class="text-end" style="padding-right: 1.25rem;">
                                    <div class="d-inline-flex gap-2">
                                        <form asp-area="Admin" asp-controller="Reviews" asp-action="ToggleApproval" asp-route-id="@r.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(r.IsApproved ? "btn-outline-warning" : "btn-outline-success")" style="padding: 0.25rem 0.6rem; font-size: 0.78rem;" title="@(r.IsApproved ? "Hide from store" : "Publish to store")">
                                                <i class="bi @(r.IsApproved ? "bi-eye-slash" : "bi-check2")"></i>
                                                @(r.IsApproved ? "Unapprove" : "Approve")
                                            </button>
                                        </form>

                                        <form asp-area="Admin" asp-controller="Reviews" asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="padding: 0.25rem 0.6rem; font-size: 0.78rem;" title="Delete review"
                                                    onclick="return confirm('Permanently remove this review?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
