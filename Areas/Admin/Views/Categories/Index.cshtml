@model List<TimeVerse.ViewModels.Admin.CategoryCrudViewModel>
@{
    ViewData["Title"] = "Categories — Admin";
}

<!-- Admin Console Header -->
<section class="tv-catalog-header" style="padding: 2rem 0 1.5rem;">
    <div class="container-xl">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <span class="tv-badge tv-badge-lime mb-2">Classifications</span>
                <h1 style="font-size: 2.2rem; color: #FFFFFF; margin-bottom: 0.25rem;">WATCH CATEGORIES</h1>
                <p style="color: #A6A59E; margin-bottom: 0;">Organize catalog classifications like Automatic, Chronograph, Diver, and Luxury.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="tv-btn-primary" style="padding: 0.55rem 1.1rem;">
                    <i class="bi bi-plus-lg me-1"></i> Add Category
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Admin Navigation Bar -->
<div class="tv-dashboard-bar">
    <div class="container-xl">
        <div class="tv-dashboard-nav">
            <a asp-area="@(User.IsInRole(TimeVerse.Data.RoleConstants.Admin) ? "Admin" : "Sales")" asp-controller="Dashboard" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-speedometer2"></i> Overview</a>
            <a asp-area="Admin" asp-controller="Watches" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-watch"></i> Watches</a>
            <a asp-area="Admin" asp-controller="Brands" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-building"></i> Brands</a>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="tv-dashboard-link active"><i class="bi bi-tags"></i> Categories</a>
            <a asp-area="@(User.IsInRole(TimeVerse.Data.RoleConstants.Admin) ? "Admin" : "Sales")" asp-controller="Orders" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-box-seam"></i> Orders</a>
            @if (User.IsInRole(TimeVerse.Data.RoleConstants.Admin))
            {
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-people"></i> Users</a>
            }
            <a asp-area="" asp-controller="Home" asp-action="Index" class="tv-dashboard-link text-white ms-auto"><i class="bi bi-box-arrow-up-right"></i> View Storefront</a>
        </div>
    </div>
</div>

<section class="tv-section-light" style="padding: 2.5rem 0 4.5rem;">
    <div class="container-xl">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4 border" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="luxury-card p-0" style="background: var(--tv-white); overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="padding-left: 1.25rem; width: 220px;">Category Name</th>
                            <th>Description</th>
                            <th class="text-center" style="width: 140px;">Timepieces</th>
                            <th class="text-center" style="width: 120px;">Status</th>
                            <th class="text-end" style="padding-right: 1.25rem; width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr class="@(!c.IsActive ? "table-secondary text-muted" : "")">
                                <td style="padding-left: 1.25rem;">
                                    <div class="fw-bold fs-6">@c.Name</div>
                                    <small class="text-muted">ID: #@c.Id</small>
                                </td>
                                <td>
                                    <div class="text-muted small">@c.Description</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@c.WatchCount timepiece(s)</span>
                                </td>
                                <td class="text-center">
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end" style="padding-right: 1.25rem;">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-dark" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;" title="Edit">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>

                                        <form asp-area="Admin" asp-controller="Categories" asp-action="ToggleStatus" asp-route-id="@c.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-warning" : "btn-outline-success")" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;" title="@(c.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(c.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                                @(c.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>

                                        <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;" title="Delete category"
                                                    onclick="return confirm('Permanently delete category @c.Name? (Protected: cannot delete if watches belong to it)');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
