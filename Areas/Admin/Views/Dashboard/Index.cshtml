@model TimeVerse.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard — TIMEVERSE";
}

<!-- Welcome Header -->
<section class="tv-catalog-header" style="padding: 2.25rem 0 1.75rem;">
    <div class="container-xl">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <span class="tv-badge tv-badge-lime mb-2 d-inline-block">Admin Portal</span>
                <h1 style="font-size: 2.3rem; color: #FFFFFF; margin-bottom: 0.35rem; font-weight: 800; letter-spacing: -0.01em;">Welcome back, Admin!</h1>
                <p style="color: #94A3B8; margin-bottom: 0; font-size: 0.95rem;">Here is the latest performance overview and order activity for TimeVerse.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-area="Admin" asp-controller="Watches" asp-action="Create" class="tv-btn-primary" style="padding: 0.65rem 1.25rem; font-weight: 600; background: #2563EB !important; border-color: #2563EB !important;">
                    <i class="bi bi-plus-lg me-1"></i> Add Watch
                </a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="tv-btn-outline-light" style="padding: 0.65rem 1.25rem; font-weight: 600;">
                    <i class="bi bi-box-seam me-1"></i> View Orders
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Admin Navigation Bar -->
<div class="tv-dashboard-bar">
    <div class="container-xl">
        <div class="tv-dashboard-nav">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="tv-dashboard-link active"><i class="bi bi-speedometer2"></i> Overview</a>
            <a asp-area="Admin" asp-controller="Watches" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-watch"></i> Watches</a>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="tv-dashboard-link"><i class="bi bi-box-seam"></i> Orders</a>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="tv-dashboard-link text-white ms-auto"><i class="bi bi-box-arrow-up-right"></i> View Storefront</a>
        </div>
    </div>
</div>

<!-- Main Dashboard Content -->
<section class="tv-section-light" style="padding: 2.5rem 0 4.5rem; background: #F8FAFC;">
    <div class="container-xl">
        <!-- 4 Summary Cards -->
        <div class="row g-4 mb-4">
            <!-- 1. Total Watches -->
            <div class="col-xl-3 col-sm-6">
                <div class="p-4 rounded-4 bg-white border h-100 shadow-sm" style="transition: transform 0.2s ease;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Total Watches</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(37, 99, 235, 0.1); color: #2563EB; font-size: 1.25rem;">
                            <i class="bi bi-watch"></i>
                        </div>
                    </div>
                    <div style="font-size: 2.2rem; font-weight: 800; color: #0F172A; line-height: 1;">@Model.TotalWatches</div>
                    <div class="text-muted small mt-2">Active in catalog</div>
                </div>
            </div>

            <!-- 2. Total Orders -->
            <div class="col-xl-3 col-sm-6">
                <div class="p-4 rounded-4 bg-white border h-100 shadow-sm" style="transition: transform 0.2s ease;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Total Orders</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(16, 185, 129, 0.1); color: #10B981; font-size: 1.25rem;">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                    <div style="font-size: 2.2rem; font-weight: 800; color: #0F172A; line-height: 1;">@Model.TotalOrders</div>
                    <div class="text-muted small mt-2">Lifetime customer orders</div>
                </div>
            </div>

            <!-- 3. Total Customers -->
            <div class="col-xl-3 col-sm-6">
                <div class="p-4 rounded-4 bg-white border h-100 shadow-sm" style="transition: transform 0.2s ease;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Total Customers</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(245, 158, 11, 0.1); color: #F59E0B; font-size: 1.25rem;">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                    <div style="font-size: 2.2rem; font-weight: 800; color: #0F172A; line-height: 1;">@Model.TotalCustomers</div>
                    <div class="text-muted small mt-2">Registered patron accounts</div>
                </div>
            </div>

            <!-- 4. Total Revenue -->
            <div class="col-xl-3 col-sm-6">
                <div class="p-4 rounded-4 bg-white border h-100 shadow-sm" style="transition: transform 0.2s ease;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">Total Revenue</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(139, 92, 246, 0.1); color: #8B5CF6; font-size: 1.25rem;">
                            <i class="bi bi-currency-rupee"></i>
                        </div>
                    </div>
                    <div style="font-size: 2.2rem; font-weight: 800; color: #0F172A; line-height: 1;">₹@Model.TotalRevenue.ToString("N0")</div>
                    <div class="text-muted small mt-2">Net verified transactions</div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Row -->
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="p-4 rounded-4 bg-white border shadow-sm">
                    <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: #0F172A;">
                        <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Quick Actions
                    </h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a asp-area="Admin" asp-controller="Watches" asp-action="Create" class="p-3 rounded-3 d-flex align-items-center gap-3 text-decoration-none border h-100" style="background: #F8FAFC; transition: all 0.2s ease;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; background: #2563EB; color: #FFF; font-size: 1.3rem;">
                                    <i class="bi bi-plus-lg"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 1rem;">Add Watch</div>
                                    <div class="text-muted small">Register a new watch to your store catalog</div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="p-3 rounded-3 d-flex align-items-center gap-3 text-decoration-none border h-100" style="background: #F8FAFC; transition: all 0.2s ease;">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; background: #0F172A; color: #FFF; font-size: 1.3rem;">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 1rem;">View Orders</div>
                                    <div class="text-muted small">Track and manage customer orders</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Orders Table (Last 5 orders) -->
        <div class="row g-4">
            <div class="col-12">
                <div class="rounded-4 bg-white border shadow-sm overflow-hidden">
                    <div class="p-3 px-4 border-bottom d-flex align-items-center justify-content-between" style="background: #F8FAFC;">
                        <h4 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0; color: #0F172A;">
                            <i class="bi bi-clock-history me-2 text-primary"></i>Recent Orders
                        </h4>
                        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-dark" style="font-size: 0.8rem; font-weight: 600;">
                            View All Orders <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="padding-left: 1.5rem;">Order Number</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end" style="padding-right: 1.5rem;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RecentOrders.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                                            No customer orders placed yet.
                                        </td>
                                    </tr>
                                }
                                @foreach (var o in Model.RecentOrders)
                                {
                                    <tr>
                                        <td style="padding-left: 1.5rem;">
                                            <span class="font-monospace fw-bold text-dark">@o.OrderNumber</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@o.CustomerName</div>
                                            <small class="text-muted">@o.CustomerEmail</small>
                                        </td>
                                        <td>
                                            <div class="text-dark">@o.OrderDate.ToString("dd MMM yyyy")</div>
                                            <small class="text-muted">@o.OrderDate.ToString("hh:mm tt")</small>
                                        </td>
                                        <td class="text-end fw-bold text-dark">₹@o.TotalAmount.ToString("N2")</td>
                                        <td class="text-center">
                                            @switch (o.Status)
                                            {
                                                case "Pending":
                                                    <span class="badge bg-warning text-dark px-2 py-1">Pending</span>
                                                    break;
                                                case "Confirmed":
                                                    <span class="badge bg-primary px-2 py-1">Confirmed</span>
                                                    break;
                                                case "Processing":
                                                    <span class="badge bg-info text-dark px-2 py-1">Processing</span>
                                                    break;
                                                case "Shipped":
                                                    <span class="badge bg-secondary px-2 py-1">Shipped</span>
                                                    break;
                                                case "Delivered":
                                                    <span class="badge bg-success px-2 py-1">Delivered</span>
                                                    break;
                                                case "Cancelled":
                                                    <span class="badge bg-danger px-2 py-1">Cancelled</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary px-2 py-1">@o.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end" style="padding-right: 1.5rem;">
                                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary" style="font-size: 0.8rem; padding: 0.3rem 0.75rem;">
                                                Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
