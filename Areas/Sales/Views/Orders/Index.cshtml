@model List<TimeVerse.ViewModels.Orders.OrderDetailsViewModel>
@{
    ViewData["Title"] = "Customer Orders — Sales";
}

<div class="luxury-container py-4">
    <nav class="breadcrumb-nav mb-3" aria-label="breadcrumb">
        <a asp-area="Sales" asp-controller="Dashboard" asp-action="Index">Sales Desk</a>
        <span class="separator">/</span>
        <span class="current">Customer Orders</span>
    </nav>

    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3 flex-wrap gap-3">
        <div>
            <span class="tv-badge tv-badge-lime mb-2 d-inline-block">Sales Desk</span>
            <h1 class="display-6 fw-bold mb-1">CUSTOMER ORDERS</h1>
            <p class="text-muted mb-0">View all customer orders, add tracking numbers, and update delivery status.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-area="Sales" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-dark" style="padding: 0.4rem 0.85rem; font-size: 0.85rem;">All Orders</a>
            <a asp-area="Sales" asp-controller="Orders" asp-action="Index" asp-route-status="@TimeVerse.Models.OrderStatus.Pending" class="btn btn-sm btn-outline-warning text-dark" style="padding: 0.4rem 0.85rem; font-size: 0.85rem;">Pending</a>
            <a asp-area="Sales" asp-controller="Orders" asp-action="Index" asp-route-status="@TimeVerse.Models.OrderStatus.Confirmed" class="btn btn-sm btn-outline-primary" style="padding: 0.4rem 0.85rem; font-size: 0.85rem;">Confirmed</a>
            <a asp-area="Sales" asp-controller="Orders" asp-action="Index" asp-route-status="@TimeVerse.Models.OrderStatus.Shipped" class="btn btn-sm btn-outline-info" style="padding: 0.4rem 0.85rem; font-size: 0.85rem;">Shipped</a>
            <a asp-area="Sales" asp-controller="Orders" asp-action="Index" asp-route-status="@TimeVerse.Models.OrderStatus.Delivered" class="btn btn-sm btn-outline-success" style="padding: 0.4rem 0.85rem; font-size: 0.85rem;">Delivered</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="luxury-card p-3" style="background: var(--tv-white);">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Customer & City</th>
                        <th>Order Date</th>
                        <th class="text-end">Amount</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Tracking Number</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-2"></i>
                                No customer orders found for this filter.
                            </td>
                        </tr>
                    }
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold fs-6">@o.OrderNumber</div>
                                <small class="text-muted">Paid: @o.PaymentMethod (@o.PaymentStatus)</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@o.ShippingFullName</div>
                                <div class="text-muted small">@o.ShippingCity, @o.ShippingState</div>
                            </td>
                            <td>
                                <div>@o.OrderDate.ToString("dd MMM yyyy")</div>
                                <small class="text-muted">@o.OrderDate.ToString("hh:mm tt")</small>
                            </td>
                            <td class="text-end fw-bold">
                                ₹@o.FinalAmount.ToString("N0")
                            </td>
                            <td class="text-center">
                                @switch (o.Status)
                                {
                                    case TimeVerse.Models.OrderStatus.Pending:
                                        <span class="tv-status-badge tv-status-pending">Pending</span>
                                        break;
                                    case TimeVerse.Models.OrderStatus.Confirmed:
                                        <span class="tv-status-badge tv-status-confirmed">Confirmed</span>
                                        break;
                                    case TimeVerse.Models.OrderStatus.Processing:
                                        <span class="tv-status-badge tv-status-processing">Packing</span>
                                        break;
                                    case TimeVerse.Models.OrderStatus.Shipped:
                                        <span class="tv-status-badge tv-status-shipped">Shipped</span>
                                        break;
                                    case TimeVerse.Models.OrderStatus.Delivered:
                                        <span class="tv-status-badge tv-status-delivered">Delivered</span>
                                        break;
                                    case TimeVerse.Models.OrderStatus.Cancelled:
                                        <span class="tv-status-badge tv-status-cancelled">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td class="text-center font-monospace small">
                                @(string.IsNullOrEmpty(o.TrackingNumber) ? "Not Assigned" : o.TrackingNumber)
                            </td>
                            <td class="text-end">
                                <a asp-area="Sales" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-dark" style="padding: 0.35rem 0.8rem; font-size: 0.82rem;">
                                    <i class="bi bi-pencil-square"></i> Manage
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
